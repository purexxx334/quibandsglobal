# ==============================================================================
# QUIBANDS GLOBAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
# 1. Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# 2. Public Anon Key (safe for client-side frontend)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Secret Service Role Key (NEVER expose to frontend, used only in backend server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
